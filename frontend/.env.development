# Local development defaults. Override per-machine in .env.local (gitignored).

# Spring Cloud Gateway (all REST APIs live under /api).
VITE_API_BASE_URL=http://localhost:8222/api

# Keycloak (realm auto-ecole, public SPA client with PKCE).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=auto-ecole
VITE_KEYCLOAK_CLIENT_ID=auto-ecole-frontend