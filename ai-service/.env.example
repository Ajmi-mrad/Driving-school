# ---- LLM (Groq, API compatible OpenAI) ----
# Clé : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq avec tool calling. Free tier : 8k tokens/minute.
AI_MODEL=openai/gpt-oss-120b

# ---- LLM de secours (optionnel) : Gemini, API compatible OpenAI ----
# Clé : https://aistudio.google.com/apikey — vide = pas de bascule.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- GitHub (serveur MCP hébergé, endpoint read-only) ----
# Fine-grained PAT limité au dépôt, permissions en LECTURE seule : Contents, Actions, Metadata.
GITHUB_TOKEN=
